# FORM_LAB_AUTH_USER=
# FORM_LAB_AUTH_PASSWORD=
# Optional cost-estimate inputs:
# LOCAL_COMPUTE_USD_PER_HOUR=
# GEMINI_INPUT_USD_PER_MILLION=
# GEMINI_OUTPUT_USD_PER_MILLION=
# GEMINI_CACHED_INPUT_USD_PER_MILLION=
